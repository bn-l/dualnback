# Cloudflare's header rules for the built site (Vite copies this file into dist/).
# Cross-origin isolation gives performance.now() and event.timeStamp the finest resolution
# the browser allows, which the round's timing relies on; every asset is same-origin, so
# nothing breaks. The dev and preview servers send the same pair (vite.config.ts).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff

# Built files have a content hash in their name, so they never change. The page itself
# keeps Cloudflare's default (max-age=0, must-revalidate), so a new deploy shows at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The link preview image is shown by other sites, so it opts out of same-origin-only loading.
/og.png
  Cross-Origin-Resource-Policy: cross-origin
