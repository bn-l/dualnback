{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["esnext", "dom", "dom.iterable"],
        "types": ["vite/client"],
        // End-to-end tests import app modules inside the browser by their dev-server URL.
        "allowImportingTsExtensions": true,
        "paths": { "/src/*": ["./src/*"], "/tests/*": ["./tests/*"] },
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        // Nothing here is JS. These stay so that a .js file which sneaks in is
        // type-checked like everything else rather than silently skipped —
        // which is what allowJs alone would do.
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "tests/**/*.ts",
        "lint/**/*.ts",
        "vite.config.ts",
        "eslint.config.ts",
        "playwright.config.ts",
        "scripts/**/*.ts"
    ]
}
