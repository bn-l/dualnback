{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nback",
  "compatibility_date": "2026-10-21",

  // The app is static: `just build` puts it in dist/, and Cloudflare serves those files
  // straight from its edge, with no Worker code. dist/_headers (from public/_headers) adds
  // the cross-origin isolation headers the round's timing needs.
  "assets": {
    "directory": "./dist"
  },

  // One address: nback.bn-l.net, on the bn-l.net zone already on Cloudflare.
  // No workers.dev copy of the site, nor of each version (Preview URLs).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "nback.bn-l.net", "custom_domain": true }]
}
